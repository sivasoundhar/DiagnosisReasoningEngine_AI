# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM Gateway ---
# GROQ_API_KEY powers the AI Reasoning Agent - an independent LLM second opinion
# surfaced as `ai_opinion` on /analyze. Leave blank to run without it: ai_opinion is simply
# null on every response, nothing else is affected. Free key: console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./data/database.db

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
